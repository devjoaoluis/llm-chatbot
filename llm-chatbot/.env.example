# --- CONFIGURAÇÕES DO OLLAMA (IA LOCAL) ---
OLLAMA_BASE_URL="http://localhost:11434/v1"
# O nome do modelo que você baixou no Ollama (ex: gemma2:latest, llama3, mistral)
OLLAMA_MODEL="gemma2:latest"

# --- CONFIGURAÇÕES DA OPENAI (NUVEM) ---
# Sua chave de API da OpenAI (opcional se usar apenas Ollama)
OPENAI_API_KEY="sua-chave-aqui"